(load "Test.carp")

(load "main.carp")

(use-all Maybe Test URI Result)

(def uri "scheme://usr:pass@domain.tld:123/path?query=1#fragment")

(defn test-parsing []
  (do
    (IO.println "## Parsing")
    (with-test test
      (assert-equal test
        &(Just @"scheme")
        (scheme &(unsafe-from-success (URI.parse uri)))
        "we can parse and get the scheme correctly")
      (assert-equal test
        &(Just @"usr")
        (user &(unsafe-from-success (URI.parse uri)))
        "we can parse and get the user correctly")
      (assert-equal test
        &(Just @"pass")
        (password &(unsafe-from-success (URI.parse uri)))
        "we can parse and get the password correctly")
      (assert-equal test
        &(Just @"domain.tld")
        (host &(unsafe-from-success (URI.parse uri)))
        "we can parse and get the host correctly")
      (assert-equal test
        &(Just 123)
        (port &(unsafe-from-success (URI.parse uri)))
        "we can parse and get the port correctly")
      (assert-equal test
        &(Just @"path")
        (path &(unsafe-from-success (URI.parse uri)))
        "we can parse and get the path correctly")
      (assert-equal test
        &(Just @"query=1")
        (query &(unsafe-from-success (URI.parse uri)))
        "we can parse and get the query correctly")
      (assert-equal test
        &{@"query" @"1"}
        &(unsafe-from-success (query-map &(unsafe-from-success (URI.parse uri))))
        "we can parse and get the query correctly as a map")
      (assert-equal test
        &{@"key-one" @"val-one"
          @"key2" @"val2"}
        &(unsafe-from-success (query-map-from-str "key-one=val-one&key2=val2"))
        "we can parse and get the query correctly as a map from a string")
      (assert-equal test
        &{@"key one" @"val one"
          @"key2" @"val2"}
        &(unsafe-from-success
          (query-map-from-str "key%20one=val%20one&key2=val2"))
        "query-map-from-str percent-decodes keys and values")
      (assert-equal test
        &{@"data" @"abc=def"}
        &(unsafe-from-success (query-map-from-str "data=abc=def"))
        "query-map-from-str handles = in values")
      (assert-equal test
        &{@"token" @"eyJ=="}
        &(unsafe-from-success (query-map-from-str "token=eyJ=="))
        "query-map-from-str handles trailing = in values (base64)")
      (assert-equal test
        &{@"a" @"1"
          @"b" @"x=y"
          @"c" @"3"}
        &(unsafe-from-success (query-map-from-str "a=1&b=x=y&c=3"))
        "query-map-from-str handles = in values mixed with normal params")
      (assert-equal test
        &{@"key" @""}
        &(unsafe-from-success (query-map-from-str "key="))
        "query-map-from-str handles empty values")
      (assert-equal test
        &{@"flag" @""}
        &(unsafe-from-success (query-map-from-str "flag"))
        "query-map-from-str reads a valueless parameter as an empty value")
      (assert-equal test
        &{@"a" @"1"
          @"debug" @""
          @"c" @"3"}
        &(unsafe-from-success (query-map-from-str "a=1&debug&c=3"))
        "query-map-from-str handles valueless params mixed with normal ones")
      (assert-equal test
        &{@"a" @""
          @"b" @""}
        &(unsafe-from-success (query-map-from-str "a&b"))
        "query-map-from-str handles several valueless params")
      (assert-equal test
        &{@"my flag" @""}
        &(unsafe-from-success (query-map-from-str "my%20flag"))
        "query-map-from-str percent-decodes a valueless key")
      (assert-equal test
        &{@"a" @"1"}
        &(unsafe-from-success (query-map-from-str "a=1&"))
        "query-map-from-str skips a trailing empty segment")
      (assert-equal test
        &{@"a" @"1"}
        &(unsafe-from-success (query-map-from-str "&a=1"))
        "query-map-from-str skips a leading empty segment")
      (assert-equal test
        &{@"a" @""
          @"b" @""}
        &(unsafe-from-success (query-map-from-str "a&&b"))
        "query-map-from-str skips a doubled empty segment")
      (assert-equal test
        &{@"flag" @""}
        &(unsafe-from-success
          (query-map &(unsafe-from-success (URI.parse "http://foo.com/?flag"))))
        "query-map reads a valueless parameter from a parsed URI")
      (assert-equal test
        &(Just @"fragment")
        (fragment &(unsafe-from-success (URI.parse uri)))
        "we can parse and get the fragment correctly")
      (assert-equal test
        &(Just @"")
        (path &(unsafe-from-success (URI.parse "/")))
        "we can parse relative URIs")
      ; an authority directly followed by ?query or #fragment (no path between)
      ; used to route the query/fragment text into the path, dropping it
      (assert-equal test
        &(Just @"q=1")
        (query &(unsafe-from-success (URI.parse "http://foo.com?q=1")))
        "a query directly after the host is captured, not swallowed as the path")
      (assert-true test
        (nothing? (path &(unsafe-from-success (URI.parse "http://foo.com?q=1"))))
        "no path is set when the authority is directly followed by a query")
      (assert-equal test
        &(Just @"frag")
        (fragment &(unsafe-from-success (URI.parse "http://foo.com#frag")))
        "a fragment directly after the host is captured, not swallowed as the path")
      (assert-equal test
        &(Just @"q=1")
        (query &(unsafe-from-success (URI.parse "http://foo.com:8080?q=1")))
        "a query directly after host:port is captured, not swallowed as the path")
      (assert-equal test
        &(Just 8080)
        (port &(unsafe-from-success (URI.parse "http://foo.com:8080?q=1")))
        "the port still parses when it is directly followed by a query")
      (assert-equal test
        &(Just @"frag")
        (fragment &(unsafe-from-success (URI.parse "http://foo.com:8080#frag")))
        "a fragment directly after host:port is captured, not swallowed as the path"))))

(defn test-ports []
  (do
    (IO.println "## Ports")
    (with-test test
      (assert-true test
        (nothing? (port &(unsafe-from-success (URI.parse "http://a.com:/x"))))
        "an empty port before a path is Nothing, not 0")
      (assert-true test
        (nothing? (port &(unsafe-from-success (URI.parse "http://a.com:"))))
        "an empty port at the end of the input is Nothing, not 0")
      (assert-true test
        (nothing? (port &(unsafe-from-success (URI.parse "http://a.com:?q=1"))))
        "an empty port before a query is Nothing, not 0")
      (assert-true test
        (nothing? (port &(unsafe-from-success (URI.parse "http://a.com:#f"))))
        "an empty port before a fragment is Nothing, not 0")
      (assert-equal test
        &(Just @"x")
        (path &(unsafe-from-success (URI.parse "http://a.com:/x")))
        "a path after an empty port is still captured")
      (assert-equal test
        &(Just @"q=1")
        (query &(unsafe-from-success (URI.parse "http://a.com:?q=1")))
        "a query after an empty port is still captured")
      (assert-equal test
        &(Just @"f")
        (fragment &(unsafe-from-success (URI.parse "http://a.com:#f")))
        "a fragment after an empty port is still captured")
      (assert-false test
        (default-port? &(unsafe-from-success (URI.parse "http://a.com:/x")))
        "an empty port is not the scheme’s default port")
      (assert-equal test
        &(Just 0)
        (port &(unsafe-from-success (URI.parse "http://a.com:0/x")))
        "an explicit zero port is a real port, not an empty one")
      (assert-equal test
        &(Just 0)
        (port &(unsafe-from-success (URI.parse "http://a.com:000/x")))
        "a zero port written with leading zeros is a real port")
      (assert-equal test
        &(Just 7)
        (port &(unsafe-from-success (URI.parse "http://a.com:007/x")))
        "leading zeros in a port are ignored")
      (assert-equal test
        &(Just 2147483647)
        (port &(unsafe-from-success (URI.parse "http://a.com:2147483647/x")))
        "the largest representable port is accepted")
      (assert-equal test
        &(Just 2147483647)
        (port &(unsafe-from-success (URI.parse "http://a.com:0002147483647/x")))
        "the largest representable port is accepted with leading zeros")
      (assert-equal test
        &(Error @"Invalid URI: bad port at character 24")
        &(URI.parse "http://a.com:99999999999/x")
        "a port that overflows is rejected instead of being clamped")
      (assert-equal test
        &(Error @"Invalid URI: bad port at character 24")
        &(URI.parse "http://a.com:99999999999")
        "a port that overflows at the end of the input is rejected")
      (assert-equal test
        &(Error @"Invalid URI: bad port at character 23")
        &(URI.parse "http://a.com:2147483648/x")
        "a port one past the largest representable one is rejected")
      (assert-equal test
        &(Error @"Invalid URI: bad port at character 23")
        &(URI.parse "http://a.com:4294967296/x")
        "a ten-digit port that overflows is rejected")
      (assert-equal test
        &(Error @"Invalid URI: bad port at character 13")
        &(URI.parse "http://a.com:-5/x")
        "a negative port is an error")
      (assert-equal test
        &(Error @"Invalid URI: bad port at character 14")
        &(URI.parse "http://a.com:8a/x")
        "a port with a trailing letter is an error")
      (assert-equal test
        "http://a.com/x"
        &(URI.str &(unsafe-from-success (URI.parse "http://a.com:/x")))
        "an empty port is dropped together with its colon")
      (assert-equal test
        "http://a.com/"
        &(URI.str &(unsafe-from-success (URI.parse "http://a.com:")))
        "an empty port at the end of the input is dropped together with its colon")
      (assert-equal test
        "http://a.com/?q=1"
        &(URI.str &(unsafe-from-success (URI.parse "http://a.com:?q=1")))
        "an empty port before a query is dropped together with its colon")
      (assert-equal test
        "http://a.com/#f"
        &(URI.str &(unsafe-from-success (URI.parse "http://a.com:#f")))
        "an empty port before a fragment is dropped together with its colon")
      (assert-equal test
        "http://a.com:0/x"
        &(URI.str &(unsafe-from-success (URI.parse "http://a.com:0/x")))
        "an explicit zero port survives stringification")
      (assert-equal test
        "http://a.com/x"
        &(URI.str
          &(normalize &(unsafe-from-success (URI.parse "http://a.com:/x"))))
        "an empty port is gone after normalization")
      (assert-equal test
        "http://a.com/?q=1"
        &(URI.str
          &(normalize &(unsafe-from-success (URI.parse "http://a.com:?q=1"))))
        "an empty port before a query is gone after normalization")
      (assert-equal test
        "http://a.com/#f"
        &(URI.str
          &(normalize &(unsafe-from-success (URI.parse "http://a.com:#f"))))
        "an empty port before a fragment is gone after normalization")
      (assert-equal test
        "http://a.com/"
        &(URI.str
          &(normalize &(unsafe-from-success (URI.parse "http://a.com:"))))
        "an empty port at the end of the input is gone after normalization")
      (assert-equal test
        "http://a.com:0/x"
        &(URI.str
          &(normalize &(unsafe-from-success (URI.parse "http://a.com:0/x"))))
        "an explicit zero port survives normalization"))))

(defn test-escaping []
  (do
    (IO.println "## Escaping")
    (with-test test
      (assert-equal test "abcd%20efg" &(escape "abcd efg") "we can escape URIs")
      (assert-equal test
        "abcd efg"
        &(unescape "abcd%20efg")
        "we can unescape URIs")
      (assert-equal test
        "test%"
        &(unescape "test%")
        "unescape passes through truncated percent at end")
      (assert-equal test
        "test%2"
        &(unescape "test%2")
        "unescape passes through percent with only one hex digit at end")
      (assert-equal test
        "%C3%A9"
        &(escape "é")
        "escape percent-encodes a Latin-1 character as its two UTF-8 bytes")
      (assert-equal test
        "%E4%B8%AD"
        &(escape "中")
        "escape percent-encodes a CJK character as its three UTF-8 bytes")
      (assert-equal test
        "%F0%9F%98%80"
        &(escape "😀")
        "escape percent-encodes an astral character as its four UTF-8 bytes")
      (assert-equal test
        "a%20%C3%A9%20z"
        &(escape "a é z")
        "escape handles ASCII and multi-byte characters in the same string")
      (assert-equal test
        "é"
        &(unescape "%C3%A9")
        "unescape reassembles UTF-8 bytes into a Latin-1 character")
      (assert-equal test
        "😀"
        &(unescape "%F0%9F%98%80")
        "unescape reassembles UTF-8 bytes into an astral character")
      (assert-equal test
        "é"
        &(unescape "%c3%a9")
        "unescape accepts lower-case hex digits")
      (assert-equal test
        "%zz"
        &(unescape "%zz")
        "unescape passes an invalid hex triplet through verbatim")
      (assert-equal test
        "a%2gb"
        &(unescape "a%2gb")
        "unescape passes a triplet with a non-hex digit through verbatim")
      (assert-equal test
        " %zz"
        &(unescape "%20%zz")
        "unescape decodes valid triplets while passing invalid ones through")
      (assert-equal test
        5
        (String.length &(unescape "a%zzb"))
        "unescape does not inject a NUL for an invalid triplet (no truncation)")
      (assert-equal test
        "é"
        &(unescape &(escape "é"))
        "escape/unescape round-trip a Latin-1 character")
      (assert-equal test
        "中文"
        &(unescape &(escape "中文"))
        "escape/unescape round-trip CJK characters")
      (assert-equal test
        "😀🎉"
        &(unescape &(escape "😀🎉"))
        "escape/unescape round-trip astral characters")
      (assert-equal test
        &(Error @"Invalid URI: bad port at character 20")
        &(URI.parse "https://domain.tld:1ab3/")
        "invalid ports lead to errors")
      (assert-equal test
        10
        (String.length &(escape "abcd efg"))
        "escape output length matches visible content (no trailing NULs)")
      (assert-equal test
        8
        (String.length &(unescape "abcd%20efg"))
        "unescape output length matches visible content (no trailing NULs)"))))

(defn test-query-string-from-map []
  (do
    (IO.println "## Query String From Map")
    (with-test test
      (assert-equal test
        ""
        &(query-string-from-map &{})
        "empty map produces empty string")
      (assert-equal test
        "key=val"
        &(query-string-from-map &{@"key" @"val"})
        "single pair produces key=val")
      (assert-equal test
        "key%20one=val%20one"
        &(query-string-from-map &{@"key one" @"val one"})
        "query-string-from-map percent-encodes keys and values")
      (assert-equal test
        "flag="
        &(query-string-from-map &{@"flag" @""})
        "an empty value is encoded as a bare key= pair")
      (assert-equal test
        &{@"flag" @""}
        &(unsafe-from-success
          (query-map-from-str &(query-string-from-map &{@"flag" @""})))
        "encode then parse round-trips a lone empty value")
      (assert-equal test
        &{@"a" @"1"
          @"debug" @""
          @"key" @"val"}
        &(unsafe-from-success
          (query-map-from-str
            &(query-string-from-map &{@"a" @"1"
                                      @"debug" @""
                                      @"key" @"val"})))
        "encode then parse round-trips empty values mixed with normal ones")
      (assert-equal test
        &{@"a b" @"c&d"}
        &(unsafe-from-success
          (query-map-from-str &(query-string-from-map &{@"a b" @"c&d"})))
        "encode then parse round-trips keys and values needing escaping")
      (assert-equal test
        &{@"section=x" @"y"}
        &(unsafe-from-success
          (query-map-from-str &(query-string-from-map &{@"section=x" @"y"})))
        "an = inside a key is escaped, so the round-trip is unambiguous")
      (assert-equal test
        &{@"name" @"café"}
        &(unsafe-from-success
          (query-map-from-str &(query-string-from-map &{@"name" @"café"})))
        "encode then parse round-trips a non-ASCII value as UTF-8"))))

(defn multimap-of [s] (unsafe-from-success (query-multimap-from-str s)))

(defn test-query-multimap []
  (do
    (IO.println "## Query Multimap")
    (with-test test
      (assert-true test
        (= &{@"a" [@"1" @"2" @"3"]} &(multimap-of "a=1&a=2&a=3"))
        "query-multimap-from-str keeps every value for a repeated key, in order")
      (assert-true test
        (= &{@"key" [@"val"]} &(multimap-of "key=val"))
        "query-multimap-from-str stores a single value as a one-element array")
      (assert-true test
        (= &{@"flag" [@""]} &(multimap-of "flag"))
        "query-multimap-from-str reads a valueless key as a single empty value")
      (assert-true test
        (= &{@"a" [@"1" @"2"]
             @"b" [@"x"]} &(multimap-of "a=1&b=x&a=2"))
        "query-multimap-from-str keeps repeated and single keys together")
      (assert-true test
        (= &(the (Map String (Array String)) {}) &(multimap-of ""))
        "query-multimap-from-str maps an empty string to an empty map")
      (assert-true test
        (= &{@"na me" [@"a b" @"c d"]}
           &(multimap-of "na%20me=a%20b&na%20me=c%20d"))
        "query-multimap-from-str percent-decodes keys and repeated values")
      (assert-true test
        (= &{@"a" [@"1" @"2"]} &(multimap-of "a=1&&a=2&"))
        "query-multimap-from-str skips empty segments while accumulating")
      (assert-true test
        (= &{@"flag" [@"" @""]} &(multimap-of "flag&flag"))
        "query-multimap-from-str preserves both occurrences of a valueless key")
      (assert-true test
        (= &{@"tag" [@"a" @"b"]}
           &(unsafe-from-success
             (query-multimap
               &(unsafe-from-success (URI.parse "http://x/?tag=a&tag=b")))))
        "query-multimap reads and preserves repeated keys from a parsed URI")
      (assert-true test
        (= &(the (Map String (Array String)) {})
           &(unsafe-from-success
             (query-multimap &(unsafe-from-success (URI.parse "http://x/")))))
        "query-multimap of a URI without a query is an empty map")
      (assert-equal test
        &[@"a" @"b"]
        &(query-values
          &(unsafe-from-success (URI.parse "http://x/?tag=a&tag=b"))
          "tag")
        "query-values returns every value for a repeated key, in order")
      (assert-equal test
        &(the (Array String) [])
        &(query-values
          &(unsafe-from-success (URI.parse "http://x/?tag=a"))
          "missing")
        "query-values yields an empty array for an absent key"))))

(defn test-stringification []
  (do
    (IO.println "## Stringification")
    (with-test test
      (let [s &(str &(unsafe-from-success (URI.parse uri)))]
        (assert-equal test
          uri
          s
          "we can convert our representation to a string again correctly")))))

(defn fp [s] (full-path &(unsafe-from-success (URI.parse s))))

(defn test-full-path []
  (do
    (IO.println "## Full path")
    (with-test test
      (assert-equal test
        "/posts?id=30&limit=5"
        &(fp "http://foo.com/posts?id=30&limit=5#time=1305298413")
        "full-path keeps the leading slash and appends the query")
      (assert-equal test
        "/a/b/c"
        &(fp "http://foo.com/a/b/c")
        "full-path keeps the leading slash on a multi-segment path")
      (assert-equal test
        "/"
        &(fp "http://foo.com/")
        "full-path of a bare trailing slash is /")
      (assert-equal test
        "/"
        &(fp "http://foo.com")
        "full-path of a URI with no path is /")
      (assert-equal test
        "/?q=1"
        &(fp "http://foo.com?q=1")
        "full-path of a query-only URI is /?..."))))

(def base-uri "http://a/b/c/d;p?q")

(defn resolved-str [ref-str]
  (let [base (unsafe-from-success (URI.parse base-uri))]
    (str &(unsafe-from-success (URI.resolve &base ref-str)))))

(defn test-resolve []
  (do
    (IO.println "## Resolve (RFC 3986 Section 5.4)")
    (with-test test
      (assert-equal test "http://a/b/c/g" &(resolved-str "g") "resolve g")
      (assert-equal test "http://a/b/c/g" &(resolved-str "./g") "resolve ./g")
      (assert-equal test "http://a/b/c/g/" &(resolved-str "g/") "resolve g/")
      (assert-equal test "http://a/g" &(resolved-str "/g") "resolve /g")
      (assert-equal test "http://g/p" &(resolved-str "//g/p") "resolve //g/p")
      (assert-equal test "http://a/b/c/d;p?y" &(resolved-str "?y") "resolve ?y")
      (assert-equal test "http://a/b/c/g?y" &(resolved-str "g?y") "resolve g?y")
      (assert-equal test
        "http://a/b/c/d;p?q#s"
        &(resolved-str "#s")
        "resolve #s")
      (assert-equal test "http://a/b/c/g#s" &(resolved-str "g#s") "resolve g#s")
      (assert-equal test
        "http://a/b/c/g?y#s"
        &(resolved-str "g?y#s")
        "resolve g?y#s")
      (assert-equal test "http://a/b/c/;x" &(resolved-str ";x") "resolve ;x")
      (assert-equal test "http://a/b/c/g;x" &(resolved-str "g;x") "resolve g;x")
      (assert-equal test
        "http://a/b/c/g;x?y#s"
        &(resolved-str "g;x?y#s")
        "resolve g;x?y#s")
      (assert-equal test "http://a/b/c/d;p?q" &(resolved-str "") "resolve empty")
      (assert-equal test "http://a/b/c/" &(resolved-str ".") "resolve .")
      (assert-equal test "http://a/b/c/" &(resolved-str "./") "resolve ./")
      (assert-equal test "http://a/b/" &(resolved-str "..") "resolve ..")
      (assert-equal test "http://a/b/" &(resolved-str "../") "resolve ../")
      (assert-equal test "http://a/b/g" &(resolved-str "../g") "resolve ../g")
      (assert-equal test "http://a/" &(resolved-str "../..") "resolve ../..")
      (assert-equal test "http://a/" &(resolved-str "../../") "resolve ../../")
      (assert-equal test
        "http://a/g"
        &(resolved-str "../../g")
        "resolve ../../g")
      (assert-equal test
        "http://a/g"
        &(resolved-str "../../../g")
        "resolve ../../../g")
      (assert-equal test
        "http://a/g"
        &(resolved-str "../../../../g")
        "resolve ../../../../g")
      (assert-equal test
        "http://a/b/c/g."
        &(resolved-str "g.")
        "resolve g. (dot is part of segment)")
      (assert-equal test
        "http://a/b/c/.g"
        &(resolved-str ".g")
        "resolve .g (dot is part of segment)")
      (assert-equal test
        "http://a/b/c/g.."
        &(resolved-str "g..")
        "resolve g.. (dots are part of segment)")
      (assert-equal test
        "http://a/b/c/..g"
        &(resolved-str "..g")
        "resolve ..g (dots are part of segment)")
      (assert-equal test
        "http://a/b/c/g?y/./x"
        &(resolved-str "g?y/./x")
        "resolve g?y/./x (dots in query are literal)")
      (assert-equal test
        "http://a/b/c/g?y/../x"
        &(resolved-str "g?y/../x")
        "resolve g?y/../x (dots in query are literal)")
      (assert-equal test
        "http://a/b/c/g#s/./x"
        &(resolved-str "g#s/./x")
        "resolve g#s/./x (dots in fragment are literal)")
      (assert-equal test
        "http://a/b/c/g#s/../x"
        &(resolved-str "g#s/../x")
        "resolve g#s/../x (dots in fragment are literal)"))))

(defn test-opaque []
  (do
    (IO.println "## Opaque URIs")
    (with-test test
      (assert-equal test
        &(Just @"mailto")
        (scheme &(unsafe-from-success (URI.parse "mailto:veit@veitheller.de")))
        "we parse the scheme of an opaque URI")
      (assert-equal test
        &(Just @"veit@veitheller.de")
        (opaque &(unsafe-from-success (URI.parse "mailto:veit@veitheller.de")))
        "we parse the opaque part as everything after the colon")
      (assert-equal test
        &(Just @"g")
        (opaque &(unsafe-from-success (URI.parse "http:g")))
        "single-character opaque parts are preserved")
      ; round-tripping opaque URIs used to double-free in `str` and emit a
      ; spurious trailing slash; these guard against regressions.
      (assert-equal test
        "mailto:veit@veitheller.de"
        &(str &(unsafe-from-success (URI.parse "mailto:veit@veitheller.de")))
        "we stringify an opaque URI back to the original")
      (assert-equal test
        "urn:isbn:0451450523"
        &(str &(unsafe-from-success (URI.parse "urn:isbn:0451450523")))
        "we stringify an opaque URI with colons in the opaque part")
      (assert-equal test
        "http:g"
        &(str &(unsafe-from-success (URI.parse "http:g")))
        "we stringify an opaque URI without a spurious trailing slash"))))

(defn normalized-str [s] (str &(normalize &(unsafe-from-success (URI.parse s)))))

(defn test-normalize []
  (do
    (IO.println "## Normalize (RFC 3986 Section 6.2)")
    (with-test test
      ; case normalization (section 6.2.2.1)
      (assert-equal test
        "http://example.com/"
        &(normalized-str "HTTP://EXAMPLE.COM/")
        "scheme and host are lower-cased")
      (assert-equal test
        &(Just @"http")
        (scheme &(normalize &(unsafe-from-success (URI.parse "HtTp://x/"))))
        "scheme is lower-cased at the field level")
      (assert-equal test
        &(Just @"example.com")
        (host
          &(normalize &(unsafe-from-success (URI.parse "http://Example.COM/"))))
        "host is lower-cased at the field level")
      (assert-equal test
        "http://User:PaSs@example.com/PaTh?QuErY=V#FrAg"
        &(normalized-str "HTTP://User:PaSs@Example.com/PaTh?QuErY=V#FrAg")
        "userinfo, path, query and fragment keep their case")
      ; percent-encoding normalization (sections 6.2.2.1 and 6.2.2.2)
      (assert-equal test
        "http://example.com/~user"
        &(normalized-str "http://example.com/%7Euser")
        "percent-encoded unreserved characters are decoded")
      (assert-equal test
        "http://example.com/a-b_c.d~e"
        &(normalized-str "http://example.com/%61-%62_%63.%64~%65")
        "all classes of unreserved percent-escapes are decoded")
      (assert-equal test
        "http://example.com/a%3Ab"
        &(normalized-str "http://example.com/a%3ab")
        "hex digits of retained percent-escapes are upper-cased")
      (assert-equal test
        "http://example.com/a%40b"
        &(normalized-str "http://example.com/a%40b")
        "reserved percent-escapes are retained (encoded @ preserved)")
      (assert-equal test
        "http://example.com/x%2Fy"
        &(normalized-str "http://example.com/x%2fy")
        "an encoded slash is preserved, not treated as a path separator")
      ; path segment normalization (section 6.2.2.3)
      (assert-equal test
        "http://example.com/a/g"
        &(normalized-str "http://example.com/a/b/c/../../g")
        "dot segments are removed from the path")
      (assert-equal test
        "http://example.com/b"
        &(normalized-str "http://example.com/a/%2E%2E/b")
        "a percent-encoded dot-segment (%2E%2E) is decoded and then removed")
      ; default-port removal (section 6.2.3)
      (assert-equal test
        &(the (Maybe Int) (Nothing))
        (port
          &(normalize
            &(unsafe-from-success (URI.parse "http://example.com:80/"))))
        "the default port for a scheme is dropped")
      (assert-equal test
        &(the (Maybe Int) (Nothing))
        (port
          &(normalize
            &(unsafe-from-success (URI.parse "HTTP://example.com:80/"))))
        "the default port is dropped even when the scheme needed lower-casing")
      (assert-equal test
        &(Just 8080)
        (port
          &(normalize
            &(unsafe-from-success (URI.parse "http://example.com:8080/"))))
        "a non-default port is kept")
      ; opaque URIs
      (assert-equal test
        "mailto:John.Doe@Example.COM"
        &(normalized-str "MAILTO:John.Doe@Example.COM")
        "an opaque URI’s scheme is lower-cased but its opaque part keeps its case")
      (assert-equal test
        "mailto:a~b"
        &(normalized-str "mailto:a%7eb")
        "percent-escapes in the opaque part are normalized")
      ; idempotence
      (let [once (normalize
              &(unsafe-from-success
                (URI.parse "HTTP://User@Example.COM:80/%7Ea/./b/../c")))
            twice (normalize &once)]
        (assert-true test (URI.= &once &twice) "normalize is idempotent"))
      ; the headline use case: equivalent URIs normalize to the same value
      (assert-true test
        (URI.=
          &(normalize
            &(unsafe-from-success
              (URI.parse "HTTP://User@Example.com:80/%7Ejoe/./index.html")))
          &(normalize
            &(unsafe-from-success
              (URI.parse "http://User@example.com/~joe/index.html"))))
        "equivalent URIs written differently normalize to the same value"))))

(defn test-remove-dot-segments []
  (do
    (IO.println "## Remove dot segments (RFC 3986 Section 5.2.4)")
    (with-test test
      (assert-equal test
        "/a/g"
        &(URI.remove-dot-segments "/a/b/c/./../../g")
        "the canonical RFC 3986 5.2.4 example collapses to /a/g")
      (assert-equal test
        "mid/6"
        &(URI.remove-dot-segments "mid/content=5/../6")
        "the RFC 3986 5.2.4 relative example collapses to mid/6")
      (assert-equal test
        "/x"
        &(URI.remove-dot-segments "/../../x")
        "leading .. cannot pop below the root (underflow is a no-op)")
      (assert-equal test
        ""
        &(URI.remove-dot-segments "")
        "an empty path stays empty")
      (assert-equal test
        "/"
        &(URI.remove-dot-segments "/")
        "a bare slash is preserved")
      (assert-equal test
        "/a/b"
        &(URI.remove-dot-segments "/a/./b")
        "an interior /./ is collapsed")
      (assert-equal test
        "/a/"
        &(URI.remove-dot-segments "/a/.")
        "a trailing /. leaves a bare slash")
      (assert-equal test
        "/"
        &(URI.remove-dot-segments "/a/..")
        "a trailing /.. pops the last segment down to the root")
      (assert-equal test
        "/a/"
        &(URI.remove-dot-segments "/a/b/..")
        "a trailing /.. pops just the last segment")
      (assert-equal test
        "/foo/.bar"
        &(URI.remove-dot-segments "/foo/.bar")
        "a segment that merely begins with a dot is not a dot-segment")
      (assert-equal test "" &(URI.remove-dot-segments ".") "a bare . is dropped")
      (assert-equal test
        ""
        &(URI.remove-dot-segments "..")
        "a bare .. is dropped")
      ; many alternating . and .. segments — also a smoke test that the
      ; single-pass rewrite stays linear on long adversarial input
      (assert-equal test
        "/a/f"
        &(URI.remove-dot-segments "/a/./b/./c/./d/./e/../../../../f")
        "a long run of . and .. segments collapses correctly"))))

(defn main []
  (Array.sum
    &[(test-parsing)
      (test-ports)
      (test-escaping)
      (test-query-string-from-map)
      (test-query-multimap)
      (test-stringification)
      (test-full-path)
      (test-remove-dot-segments)
      (test-resolve)
      (test-opaque)
      (test-normalize)]))
